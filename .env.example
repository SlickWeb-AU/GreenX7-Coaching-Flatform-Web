# ---------------------------------------------------------------------------
# URL của NestJS backend — chỉ dùng ở phía SERVER (route handler + middleware).
# KHÔNG có tiền tố NEXT_PUBLIC_: trình duyệt không bao giờ gọi thẳng BE,
# mọi request đều đi qua BFF của Next để token nằm yên trong httpOnly cookie.
#
#   Dev  : http://localhost:8000/api/v1
#   Docker: http://api:8000/api/v1   (tên service trong docker-compose)
# ---------------------------------------------------------------------------
API_URL=http://localhost:8000/api/v1

# Secret dùng để VERIFY access token trong middleware (edge runtime).
# Phải TRÙNG với JWT_ACCESS_SECRET bên GreenX7-BE.
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long

# true khi chạy HTTPS. Để false nếu deploy bằng IP/HTTP (cookie sẽ không được gửi qua http nếu bật).
COOKIE_SECURE=false

# URL công khai của FE — dùng cho metadata, canonical, Open Graph.
# Đọc lúc RUNTIME nên đổi được mà không cần build lại image.
APP_URL=http://localhost:3000
